#!/usr/bin/env bash
# Create and provision a temporary macOS keychain for unattended signing.
#
# The script imports Developer ID Application / Installer certificates from
# $SIGNING_KEYS_DIR (defaults to ~/DIGIO_Software_Signing_Keys), configures the
# key partition list for Apple signing tools, and optionally stores a notarytool
# profile in the same temporary keychain.
#
# Intended for CI / SSH sessions where unlocking the login keychain would
# otherwise require an interactive GUI prompt.

set -euo pipefail

if [[ "$(uname)" != "Darwin" ]]; then
    echo "Error: this script must be run on macOS." >&2
    exit 1
fi

for tool in security openssl; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "Error: required tool '$tool' not found." >&2
        exit 1
    }
done

SIGNING_KEYS_DIR="${SIGNING_KEYS_DIR:-$HOME/DIGIO_Software_Signing_Keys}"
KEYCHAIN_NAME="${MACOS_SIGN_KEYCHAIN_NAME:-pando-build.keychain-db}"
KEYCHAIN_PASSWORD="${MACOS_SIGN_KEYCHAIN_PASSWORD:-${KEYSTORE_PASS:-}}"
KEYCHAIN_TIMEOUT_SECONDS="${MACOS_SIGN_KEYCHAIN_TIMEOUT_SECONDS:-21600}"
NOTARY_PROFILE="${NOTARY_PROFILE:-pando-notary}"
NOTARYTOOL_STORE_CREDENTIALS="${NOTARYTOOL_STORE_CREDENTIALS:-0}"
DEFAULT_KEYCHAIN="${MACOS_SIGN_KEYCHAIN_DEFAULT:-0}"

if [[ -z "$KEYCHAIN_PASSWORD" ]]; then
    echo "Error: MACOS_SIGN_KEYCHAIN_PASSWORD or KEYSTORE_PASS must be set." >&2
    exit 1
fi

if [[ ! -d "$SIGNING_KEYS_DIR" ]]; then
    echo "Error: signing keys directory not found: $SIGNING_KEYS_DIR" >&2
    exit 1
fi

normalize_name() {
    local value="$1"
    value="${value%.keychain-db}"
    value="${value%.keychain}"
    printf '%s' "$value"
}

KEYCHAIN_BASE_NAME="$(normalize_name "$KEYCHAIN_NAME")"
KEYCHAIN_PATH="${MACOS_SIGN_KEYCHAIN_PATH:-$HOME/Library/Keychains/${KEYCHAIN_BASE_NAME}-db}"
KEYCHAIN_PATH_NO_EXT="${KEYCHAIN_PATH%-db}"
KEYCHAIN_PATH_LEGACY="${KEYCHAIN_PATH_NO_EXT}.keychain"

find_first_match() {
    local pattern="$1"
    python3 - "$SIGNING_KEYS_DIR" "$pattern" <<'PY'
import fnmatch
import os
import sys
base, pattern = sys.argv[1], sys.argv[2]
for root, dirs, files in os.walk(base):
    dirs.sort()
    files.sort()
    for name in files:
        if fnmatch.fnmatch(name.lower(), pattern.lower()):
            print(os.path.join(root, name))
            raise SystemExit(0)
raise SystemExit(1)
PY
}

APP_CERT_PATH="${MACOS_APP_CERT_PATH:-}"
INSTALLER_CERT_PATH="${MACOS_INSTALLER_CERT_PATH:-}"

if [[ -z "$APP_CERT_PATH" ]]; then
    APP_CERT_PATH="$(find_first_match '*developer*id*application*.p12' || true)"
fi
if [[ -z "$INSTALLER_CERT_PATH" ]]; then
    INSTALLER_CERT_PATH="$(find_first_match '*developer*id*installer*.p12' || true)"
fi

if [[ -z "$APP_CERT_PATH" || ! -f "$APP_CERT_PATH" ]]; then
    echo "Error: Developer ID Application .p12 not found in $SIGNING_KEYS_DIR." >&2
    echo "Set MACOS_APP_CERT_PATH explicitly if needed." >&2
    exit 1
fi
if [[ -z "$INSTALLER_CERT_PATH" || ! -f "$INSTALLER_CERT_PATH" ]]; then
    echo "Error: Developer ID Installer .p12 not found in $SIGNING_KEYS_DIR." >&2
    echo "Set MACOS_INSTALLER_CERT_PATH explicitly if needed." >&2
    exit 1
fi

APP_CERT_PASSWORD="${MACOS_APP_CERT_PASSWORD:-${SIGNING_CERT_PASSWORD:-${CERT_PASSWORD:-}}}"
INSTALLER_CERT_PASSWORD="${MACOS_INSTALLER_CERT_PASSWORD:-${SIGNING_CERT_PASSWORD:-${CERT_PASSWORD:-$APP_CERT_PASSWORD}}}"

# Empty passwords are valid for some exported .p12 files. Keep supporting
# explicit overrides, but do not require passwords when the PKCS#12 bundles are
# unencrypted.

extract_identity_sha1() {
    local p12_path="$1"
    local p12_password="$2"
    openssl pkcs12 -legacy -in "$p12_path" -nokeys -clcerts -passin "pass:$p12_password" 2>/dev/null \
        | openssl x509 -noout -fingerprint -sha1 \
        | awk -F= '{gsub(":", "", $2); print $2}'
}

extract_identity_name() {
    local p12_path="$1"
    local p12_password="$2"
    openssl pkcs12 -legacy -in "$p12_path" -nokeys -clcerts -passin "pass:$p12_password" 2>/dev/null \
        | openssl x509 -noout -subject -nameopt RFC2253 \
        | sed -n 's/^subject=//p' \
        | awk -F',' '{for (i=1; i<=NF; i++) if ($i ~ /^CN=/) {sub(/^CN=/, "", $i); print $i; exit}}'
}

APP_IDENTITY_SHA1="${SIGNING_IDENTITY:-$(extract_identity_sha1 "$APP_CERT_PATH" "$APP_CERT_PASSWORD")}"
PKG_IDENTITY_SHA1="${PKG_SIGN_IDENTITY:-$(extract_identity_sha1 "$INSTALLER_CERT_PATH" "$INSTALLER_CERT_PASSWORD")}"
APP_IDENTITY_NAME="${MACOS_APP_IDENTITY_NAME:-$(extract_identity_name "$APP_CERT_PATH" "$APP_CERT_PASSWORD")}"
PKG_IDENTITY_NAME="${MACOS_INSTALLER_IDENTITY_NAME:-$(extract_identity_name "$INSTALLER_CERT_PATH" "$INSTALLER_CERT_PASSWORD")}"

if [[ -z "$APP_IDENTITY_SHA1" || -z "$PKG_IDENTITY_SHA1" ]]; then
    echo "Error: failed to extract signing identities from .p12 files." >&2
    exit 1
fi

# `security create-keychain <name>` materializes a file named "<name>-db" under
# ~/Library/Keychains. Detection must cover every spelling that may already be on
# disk, because `show-keychain-info` only succeeds for keychains that are in the
# current search list (a freshly created, never-added keychain would be missed).
KEYCHAIN_EXISTS=0
keychain_dir="$HOME/Library/Keychains"
for candidate in \
    "$KEYCHAIN_PATH" \
    "$KEYCHAIN_PATH_LEGACY" \
    "$keychain_dir/${KEYCHAIN_BASE_NAME}-db" \
    "$keychain_dir/${KEYCHAIN_BASE_NAME}.keychain-db" \
    "$keychain_dir/${KEYCHAIN_BASE_NAME}.keychain"; do
    if [[ -f "$candidate" ]] || security show-keychain-info "$candidate" >/dev/null 2>&1; then
        KEYCHAIN_EXISTS=1
        break
    fi
done
if [[ "$KEYCHAIN_EXISTS" == "0" ]] && \
   security show-keychain-info "$KEYCHAIN_BASE_NAME" >/dev/null 2>&1; then
    KEYCHAIN_EXISTS=1
fi

if [[ "$KEYCHAIN_EXISTS" == "1" ]]; then
    echo "Reusing existing keychain: $KEYCHAIN_PATH"
else
    # Even with the checks above there is a race / naming corner case where the
    # keychain exists but was not detected. Treat the "already exists" error as a
    # reuse instead of aborting the whole release build.
    create_output=""
    create_status=0
    create_output="$(security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_BASE_NAME" 2>&1)" || create_status=$?
    if [[ "$create_status" -ne 0 ]]; then
        if printf '%s' "$create_output" | grep -qi "already exists"; then
            echo "Keychain already exists, reusing: $KEYCHAIN_PATH"
        else
            printf '%s\n' "$create_output" >&2
            exit "$create_status"
        fi
    fi
fi

security set-keychain-settings -lut "$KEYCHAIN_TIMEOUT_SECONDS" "$KEYCHAIN_BASE_NAME"
security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_BASE_NAME"

# Only add the keychain when it is not already in the search list: an
# unconditional -s re-appends it on every run and the list grows without bound.
CURRENT_KEYCHAINS="$(security list-keychains -d user | tr -d '"')"
if ! printf '%s' "$CURRENT_KEYCHAINS" | grep -qF "$KEYCHAIN_PATH"; then
    security list-keychains -d user -s "$KEYCHAIN_PATH" $CURRENT_KEYCHAINS
fi
if [[ "$DEFAULT_KEYCHAIN" == "1" ]]; then
    security default-keychain -d user -s "$KEYCHAIN_PATH"
fi

import_cert() {
    local cert_path="$1"
    local cert_password="$2"
    security import "$cert_path" \
        -k "$KEYCHAIN_PATH" \
        -P "$cert_password" \
        -f pkcs12 \
        -A \
        -T /usr/bin/codesign \
        -T /usr/bin/security \
        -T /usr/bin/productsign \
        -T /usr/bin/productbuild \
        -T /usr/bin/pkgbuild \
        -T /usr/bin/xcrun
}

import_cert "$APP_CERT_PATH" "$APP_CERT_PASSWORD"
import_cert "$INSTALLER_CERT_PATH" "$INSTALLER_CERT_PASSWORD"

security set-key-partition-list \
    -S apple-tool:,apple:,codesign:,productsign:,productbuild:,pkgbuild: \
    -s -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH" >/dev/null

if [[ "$NOTARYTOOL_STORE_CREDENTIALS" == "1" ]]; then
    : "${NOTARY_APPLE_ID:?Set NOTARY_APPLE_ID to store notarytool credentials.}"
    : "${NOTARY_TEAM_ID:?Set NOTARY_TEAM_ID to store notarytool credentials.}"
    : "${NOTARY_APP_PASSWORD:?Set NOTARY_APP_PASSWORD to store notarytool credentials.}"
    xcrun notarytool store-credentials "$NOTARY_PROFILE" \
        --apple-id "$NOTARY_APPLE_ID" \
        --team-id "$NOTARY_TEAM_ID" \
        --password "$NOTARY_APP_PASSWORD" \
        --keychain "$KEYCHAIN_PATH"
fi

echo "Temporary signing keychain ready: $KEYCHAIN_PATH"
echo "Export these variables before running make/scripts:"
echo "  export MACOS_SIGN_KEYCHAIN_PATH='$KEYCHAIN_PATH'"
echo "  export MACOS_SIGN_KEYCHAIN_PASSWORD='$KEYCHAIN_PASSWORD'"
echo "  export SIGNING_IDENTITY='$APP_IDENTITY_SHA1'"
echo "  export PKG_SIGN_IDENTITY='$PKG_IDENTITY_SHA1'"
echo "  export NOTARY_PROFILE='$NOTARY_PROFILE'"
echo ""
echo "Application identity: $APP_IDENTITY_NAME [$APP_IDENTITY_SHA1]"
echo "Installer identity:   $PKG_IDENTITY_NAME [$PKG_IDENTITY_SHA1]"
security find-identity -v -p codesigning "$KEYCHAIN_PATH" || true
