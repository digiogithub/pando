#!/usr/bin/env bash
# build-macos-app — Build per-architecture macOS .app bundles and .pkg installers for Pando.
#
# For each architecture (arm64, x64) this assembles a Pando.app that ships the
# desktop wrapper (pando-desktop) as a REAL signed file inside the bundle,
# alongside the CLI binary (pando-bin). The wrapper is no longer extracted from
# a go:embed at runtime, so macOS does not kill it: it runs in place from its
# signed & notarized location.
#
# Usage:
#   scripts/build-macos-app [VERSION]
#
#   VERSION  Optional. Defaults to the latest git describe output (git describe --tags).
#
# Non-interactive signing uses a temporary keychain via $MACOS_SIGN_KEYCHAIN_PATH.
# Create it with scripts/setup-macos-signing-keychain before running this script.
#
# Prerequisites (macOS only):
#   - Xcode Command Line Tools: lipo, iconutil, sips, pkgbuild, productbuild, productsign,
#     pkgutil, codesign, spctl
#   - wails CLI (to build the per-arch desktop wrapper)
#   - PKG_SIGN_IDENTITY (recommended) Installer certificate common name for productsign,
#     e.g. "Developer ID Installer: Example Corp (TEAMID)"
#
# Required dist/ artifacts (produced by 'make release-darwin-amd64 release-darwin-arm64'):
#   dist/pando-darwin-x64.zip     (signed, hardened runtime — notarized here)
#   dist/pando-darwin-arm64.zip   (signed, hardened runtime — notarized here)
#
# These CLI zips are notarized in place (submit-only): a bare Mach-O cannot carry
# a stapled ticket, so a quarantined copy passes only Gatekeeper's ONLINE check.
# For offline first-run, distribute the stapled .pkg below.
#
# Outputs in dist/ (one set per architecture):
#   pando-darwin-<arch>.zip                 Signed & notarized CLI binary (submit-only)
#   Pando-<arch>.app                       Signed .app bundle (arch = arm64|x64)
#   pando-<VERSION>-darwin-<arch>.pkg       Signed & notarized flat-package installer
#   pando-<VERSION>-darwin-<arch>.pkg.zip   Compressed installer

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DIST_DIR="$REPO_ROOT/dist"
ASSETS_DIR="$REPO_ROOT/assets"
DESKTOP_DIR="$REPO_ROOT/desktop"

# ── Guards ──────────────────────────────────────────────────────────────────

if [[ "$(uname)" != "Darwin" ]]; then
    echo "Error: this script must be run on macOS." >&2
    exit 1
fi

for tool in lipo iconutil sips pkgbuild productbuild productsign pkgutil codesign spctl ditto; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "Error: required tool '$tool' not found. Install Xcode Command Line Tools." >&2
        exit 1
    }
done

# ── Locate wails ──────────────────────────────────────────────────────────────

WAILS="${WAILS:-}"
if [[ -z "$WAILS" ]]; then
    if command -v wails >/dev/null 2>&1; then
        WAILS="$(command -v wails)"
    elif [[ -x "$(go env GOPATH)/bin/wails" ]]; then
        WAILS="$(go env GOPATH)/bin/wails"
    fi
fi
if [[ -z "$WAILS" || ! -x "$WAILS" ]]; then
    echo "Error: wails CLI not found. Install it with 'make desktop-deps'." >&2
    exit 1
fi

# ── Identities ─────────────────────────────────────────────────────────────────
PKG_SIGN_IDENTITY="${PKG_SIGN_IDENTITY:-961FF87CC1EF61866640E471FB84B73E001281AF}"
SIGNING_IDENTITY="${SIGNING_IDENTITY:-4749EC5719E91D7ADFE5FDB4CB546057A8CFB9AD}"

# notarytool profile should be stored in the temporary signing keychain with:
#   xcrun notarytool store-credentials "pando-notary" --apple-id ... --team-id ... --password ... --keychain <temp-keychain>
# Leave empty (or unset NOTARY_PROFILE) to skip notarization & stapling.
NOTARY_PROFILE="${NOTARY_PROFILE:-pando-notary}"
MACOS_SIGN_KEYCHAIN_PATH="${MACOS_SIGN_KEYCHAIN_PATH:-}"
MACOS_SIGN_KEYCHAIN_PASSWORD="${MACOS_SIGN_KEYCHAIN_PASSWORD:-${KEYSTORE_PASS:-}}"

if [[ -z "$MACOS_SIGN_KEYCHAIN_PATH" ]]; then
    echo "Error: MACOS_SIGN_KEYCHAIN_PATH is required. Run scripts/setup-macos-signing-keychain first." >&2
    exit 1
fi

if [[ -z "$MACOS_SIGN_KEYCHAIN_PASSWORD" ]]; then
    echo "Error: MACOS_SIGN_KEYCHAIN_PASSWORD or KEYSTORE_PASS is required for the temporary signing keychain." >&2
    exit 1
fi

run_codesign() {
    local target="${@: -1}"
    local args=()

    if (($# > 1)); then
        args=("${@:1:$#-1}")
    fi

    if codesign --remove-signature "$target" >/dev/null 2>&1; then
        echo "Removed existing signature from $target before re-signing."
    fi

    # --timestamp is mandatory for notarization (the notary service rejects
    # signatures without a secure timestamp).
    codesign "${args[@]}" --timestamp --keychain "$MACOS_SIGN_KEYCHAIN_PATH" --sign "$SIGNING_IDENTITY" --force "$target"
}

verify_macho_signature() {
    local target="$1"
    local spctl_output
    echo "Verifying Mach-O signature: $target"
    codesign --verify --deep --strict --verbose=2 "$target"

    if spctl_output="$(spctl --assess --type execute --verbose=2 "$target" 2>&1)"; then
        printf '%s\n' "$spctl_output"
        return 0
    fi

    printf '%s\n' "$spctl_output"
    if [[ "$spctl_output" == *"rejected (the code is valid but does not seem to be an app)"* ]]; then
        echo "spctl execute assessment skipped for non-app Mach-O binary."
        return 0
    fi

    return 1
}

verify_app_signature() {
    local target="$1"
    echo "Verifying app bundle signature: $target"
    codesign --verify --deep --strict --verbose=2 "$target"
    spctl --assess --type execute --verbose=2 "$target"
}

verify_pkg_signature() {
    local target="$1"
    echo "Verifying pkg signature: $target"
    pkgutil --check-signature "$target"
    spctl --assess --type install --verbose=2 "$target"
}

is_pkg_signed() {
    local target="$1"
    pkgutil --check-signature "$target" >/dev/null 2>&1
}

# Submit an artifact to Apple's notary service and wait for the verdict.
# Accepts anything notarytool understands (.pkg, .dmg, .app, or a .zip wrapping
# Mach-O binaries). On success Apple registers the CDHash of every contained
# Mach-O, so Gatekeeper accepts them even without a stapled ticket (via its
# online check). Skipped when NOTARY_PROFILE is empty or xcrun is unavailable;
# returns 2 in that "skipped" case so callers can avoid a follow-up staple.
notarize_submit() {
    local target="$1"

    if [[ -z "$NOTARY_PROFILE" ]]; then
        echo "NOTARY_PROFILE not set — skipping notarization for $target." >&2
        return 2
    fi
    if ! command -v xcrun >/dev/null 2>&1; then
        echo "Warning: xcrun not found — skipping notarization for $target." >&2
        return 2
    fi

    echo "Submitting to Apple notary service (profile: $NOTARY_PROFILE): $target"
    if ! xcrun notarytool submit "$target" \
            --keychain-profile "$NOTARY_PROFILE" \
            --keychain "$MACOS_SIGN_KEYCHAIN_PATH" \
            --wait; then
        echo "Error: notarization failed for $target." >&2
        echo "  Inspect the log with:" >&2
        echo "  xcrun notarytool log <submission-id> --keychain-profile \"$NOTARY_PROFILE\"" >&2
        return 1
    fi
}

# Notarize an artifact and staple the resulting ticket into it. Only bundle-like
# containers (.app, .pkg, .dmg) can carry a stapled ticket. Without notarization,
# Gatekeeper rejects Developer ID packages with
# "rejected (source=Unnotarized Developer ID)".
notarize_and_staple() {
    local target="$1"
    local rc=0
    notarize_submit "$target" || rc=$?
    [[ $rc -eq 2 ]] && return 0   # skipped (no profile / no xcrun)
    [[ $rc -ne 0 ]] && return $rc

    echo "Stapling notarization ticket: $target"
    xcrun stapler staple "$target"
    xcrun stapler validate "$target"
}

# Notarize a .app bundle and staple the ticket into it. notarytool cannot ingest
# a bare .app directory, so it is zipped (ditto --keepParent) for submission;
# stapling then targets the .app itself (bundles CAN carry a stapled ticket).
notarize_and_staple_app() {
    local app="$1"
    local zip="${app%.app}.notarize.zip"
    rm -f "$zip"
    ditto -c -k --keepParent "$app" "$zip"
    local rc=0
    notarize_submit "$zip" || rc=$?
    rm -f "$zip"
    [[ $rc -eq 2 ]] && return 0   # skipped (no profile / no xcrun)
    [[ $rc -ne 0 ]] && return $rc

    echo "Stapling notarization ticket: $app"
    xcrun stapler staple "$app"
    xcrun stapler validate "$app"
}

# Notarize a release .zip that wraps a bare CLI Mach-O. A ticket CANNOT be
# stapled to a bare Mach-O or to a .zip — only online Gatekeeper validation
# applies. After this succeeds, any quarantined copy of the contained binary
# passes on machines WITH network access. For offline first-run guarantees,
# distribute the stapled .pkg instead.
notarize_cli_zip() {
    local zip="$1"
    local rc=0
    notarize_submit "$zip" || rc=$?
    [[ $rc -eq 2 ]] && return 0   # skipped (no profile / no xcrun)
    [[ $rc -ne 0 ]] && return $rc
    echo "Notarized (submit-only, no staple possible for a bare Mach-O): $zip"
    echo "  Quarantined copies pass Gatekeeper's online check; offline first-run needs the .pkg."
}

echo "Using signing identity: $SIGNING_IDENTITY"
echo "Using installer identity: $PKG_SIGN_IDENTITY"
echo "Using signing keychain: $MACOS_SIGN_KEYCHAIN_PATH"

security unlock-keychain -p "$MACOS_SIGN_KEYCHAIN_PASSWORD" "$MACOS_SIGN_KEYCHAIN_PATH" >/dev/null 2>&1 || true

cleanup() {
    rm -rf "$WORK_DIR"
}
trap cleanup EXIT

# ── Version ─────────────────────────────────────────────────────────────────

VERSION="${1:-$(git -C "$REPO_ROOT" describe --tags 2>/dev/null || echo "dev")}"
# Strip leading 'v' for CFBundleVersion (e.g. v1.2.3 → 1.2.3)
BUNDLE_VERSION="${VERSION#v}"
echo "Building Pando.app  version: ${VERSION}  bundle: ${BUNDLE_VERSION}"

# ── Input zips ──────────────────────────────────────────────────────────────

AMD64_ZIP="$DIST_DIR/pando-darwin-x64.zip"
ARM64_ZIP="$DIST_DIR/pando-darwin-arm64.zip"

for f in "$AMD64_ZIP" "$ARM64_ZIP"; do
    [[ -f "$f" ]] || {
        echo "Error: missing $f"
        echo "  Run 'make release-darwin-amd64 release-darwin-arm64' first." >&2
        exit 1
    }
done

# ── Notarize the loose CLI release zips ───────────────────────────────────────
# The zips are produced signed (hardened runtime + timestamp) by
# 'make release-darwin-*' via scripts/codesign-macos, but not notarized, so a
# distributed copy is killed by Gatekeeper once it carries com.apple.quarantine.
# Notarize each zip here (submit-only — a bare Mach-O cannot be stapled).
verify_zip_binary_signed() {
    local zip="$1"
    local probe="$WORK_DIR/zipcheck"
    rm -rf "$probe"; mkdir -p "$probe"
    unzip -q "$zip" -d "$probe"
    local bin
    bin="$(find "$probe" -maxdepth 1 -name 'pando-darwin-*' -type f | head -n1)"
    [[ -n "$bin" ]] || { echo "Error: no CLI binary inside $zip" >&2; return 1; }
    # notarytool rejects binaries without a hardened-runtime signature + timestamp.
    # Capture to a variable and match with a bash glob (no pipe): `codesign | grep
    # -q` would let grep close the pipe on first match, giving codesign a SIGPIPE
    # whose non-zero status `set -o pipefail` propagates as a false "unsigned".
    local cs_out
    cs_out="$(codesign -dv --verbose=2 "$bin" 2>&1 || true)"
    if [[ "$cs_out" != *"(runtime)"* ]]; then
        echo "Error: $(basename "$zip") binary is not signed with the hardened runtime." >&2
        echo "  Re-run 'make release-darwin-*' with SIGNING_IDENTITY + MACOS_CODESIGN_WRAPPER set." >&2
        return 1
    fi
    rm -rf "$probe"
}

# ── Workspace ───────────────────────────────────────────────────────────────

WORK_DIR="$(mktemp -d)"
mkdir -p "$DIST_DIR"

# Notarize the loose CLI zips now that WORK_DIR exists (probe extracts into it).
echo ""
echo "Notarizing loose CLI release zips..."
for zip in "$ARM64_ZIP" "$AMD64_ZIP"; do
    verify_zip_binary_signed "$zip"
    notarize_cli_zip "$zip"
done

# ── Shared icon: PNG → ICNS (built once, reused per arch) ─────────────────────

echo "Converting icon to AppIcon.icns..."
SRC_ICON="$ASSETS_DIR/pando_icon0_optim.png"
ICONSET="$WORK_DIR/AppIcon.iconset"
mkdir -p "$ICONSET"
for size in 16 32 64 128 256 512; do
    sips -z "$size" "$size" "$SRC_ICON" --out "$ICONSET/icon_${size}x${size}.png"     >/dev/null 2>&1
    dbl=$((size * 2))
    sips -z "$dbl" "$dbl" "$SRC_ICON" --out "$ICONSET/icon_${size}x${size}@2x.png"     >/dev/null 2>&1
done
SHARED_ICNS="$WORK_DIR/AppIcon.icns"
iconutil -c icns "$ICONSET" -o "$SHARED_ICNS"

# ── Build the desktop wrapper, per architecture, with wails ───────────────────
# wails build -platform darwin/<goarch> produces a thin Pando.app whose
# Contents/MacOS/pando-desktop is the arch-specific wrapper executable.
build_wrapper() {
    local goarch="$1"          # amd64 | arm64
    local out_bin="$2"         # destination path for the thin pando-desktop

    echo "Building desktop wrapper (darwin/${goarch}) with wails..."
    ( cd "$DESKTOP_DIR" && "$WAILS" build -platform "darwin/${goarch}" -clean -o pando-desktop )

    local built="$DESKTOP_DIR/build/bin/Pando.app/Contents/MacOS/pando-desktop"
    if [[ ! -f "$built" ]]; then
        # Fallback: some wails versions emit a bare binary instead of a bundle.
        built="$DESKTOP_DIR/build/bin/pando-desktop"
    fi
    [[ -f "$built" ]] || { echo "Error: wails did not produce a pando-desktop for darwin/${goarch}." >&2; exit 1; }
    cp "$built" "$out_bin"
    chmod +x "$out_bin"
}

# ── Per-arch bundle + pkg assembly ────────────────────────────────────────────
# args: <arch-label> <goarch> <cli-zip>
build_arch_package() {
    local arch_label="$1"      # arm64 | x64   (matches dist artifact naming)
    local goarch="$2"          # arm64 | amd64 (GOARCH for the wrapper)
    local cli_zip="$3"

    echo ""
    echo "════════════════════════════════════════════════════════════════"
    echo "Building package for darwin/${arch_label}"
    echo "════════════════════════════════════════════════════════════════"

    local arch_work="$WORK_DIR/$arch_label"
    mkdir -p "$arch_work"

    # 1. Extract the thin CLI binary (pando-bin).
    echo "Extracting CLI binary..."
    unzip -q "$cli_zip" -d "$arch_work"
    local cli_bin
    cli_bin="$(find "$arch_work" -maxdepth 1 -name 'pando-darwin-*' -type f | head -n1)"
    [[ -n "$cli_bin" ]] || { echo "Error: CLI binary not found in $cli_zip" >&2; exit 1; }
    chmod +x "$cli_bin"

    # 2. Build the thin desktop wrapper for this arch.
    local wrapper_bin="$arch_work/pando-desktop"
    build_wrapper "$goarch" "$wrapper_bin"

    # 3. Assemble Pando.app.
    local app_dir="$arch_work/Pando.app"
    local macos_dir="$app_dir/Contents/MacOS"
    local res_dir="$app_dir/Contents/Resources"
    mkdir -p "$macos_dir" "$res_dir"

    # Actual CLI binary — named pando-bin to avoid case-collision with the shell
    # wrapper on case-insensitive APFS/HFS+ volumes (pando == Pando).
    cp "$cli_bin" "$macos_dir/pando-bin"
    chmod +x "$macos_dir/pando-bin"

    # Desktop wrapper — shipped as a real file. At runtime `pando-bin desktop`
    # finds and launches this sibling directly (see internal/desktop/launcher.go),
    # so it runs from its signed/notarized location instead of a temp dir.
    cp "$wrapper_bin" "$macos_dir/pando-desktop"
    chmod +x "$macos_dir/pando-desktop"

    # CFBundleExecutable wrapper — invoked when the user opens the .app.
    cat > "$macos_dir/pando" <<'WRAPPER'
#!/bin/bash
# Launch Pando in desktop mode when opened as a macOS application.
SELF="$(cd "$(dirname "$0")" && pwd)"
exec "$SELF/pando-bin" desktop
WRAPPER
    chmod +x "$macos_dir/pando"

    cp "$SHARED_ICNS" "$res_dir/AppIcon.icns"
    sed "s/{{VERSION}}/$BUNDLE_VERSION/g" "$SCRIPT_DIR/Info.plist.tpl" \
        > "$app_dir/Contents/Info.plist"

    # 4. Sign inside-out: nested executables first, then the bundle.
    echo "Signing bundle executables (inside-out)..."
    run_codesign -o runtime "$macos_dir/pando-bin"
    run_codesign -o runtime "$macos_dir/pando-desktop"

    local final_app="$DIST_DIR/Pando-${arch_label}.app"
    rm -rf "$final_app"
    cp -R "$app_dir" "$final_app"

    echo "Signing Pando.app bundle..."
    run_codesign --deep -o runtime "$final_app"

    # Notarize & staple the .app BEFORE it goes into the .pkg. Stapling works on a
    # bundle (unlike a bare Mach-O), so the installed app is offline-safe and the
    # nested pando-desktop wrapper — launched in place from Contents/MacOS by
    # internal/desktop/launcher.go — is covered by the same notarization.
    # pkgbuild then copies the already-stapled .app into the installer.
    notarize_and_staple_app "$final_app"
    verify_app_signature "$final_app"

    # 5. Build the .pkg installer.
    echo "Building .pkg installer for ${arch_label}..."
    local pkg_work="$arch_work/pkg"
    local app_stage="$pkg_work/app-root"
    local launcher_stage="$pkg_work/launcher-root"
    mkdir -p "$app_stage/Applications" "$launcher_stage/usr/local/bin"

    # Install the bundle as /Applications/Pando.app (canonical name).
    cp -R "$final_app" "$app_stage/Applications/Pando.app"

    # /usr/local/bin/pando — calls the real CLI inside the .app.
    cat > "$launcher_stage/usr/local/bin/pando" <<'LAUNCHER'
#!/bin/sh
exec /Applications/Pando.app/Contents/MacOS/pando-bin "$@"
LAUNCHER
    chmod +x "$launcher_stage/usr/local/bin/pando"

    local app_pkg="$pkg_work/pando-app.pkg"
    local launcher_pkg="$pkg_work/pando-launcher.pkg"

    pkgbuild \
        --root "$app_stage" \
        --identifier "es.digio.pando" \
        --version "$BUNDLE_VERSION" \
        --install-location "/" \
        "$app_pkg"

    pkgbuild \
        --root "$launcher_stage" \
        --identifier "es.digio.pando.launcher" \
        --version "$BUNDLE_VERSION" \
        --install-location "/" \
        "$launcher_pkg"

    local dist_xml="$pkg_work/distribution.xml"
    cat > "$dist_xml" <<XML
<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Pando ${VERSION} (${arch_label})</title>
    <organization>es.digio</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="false"/>
    <choices-outline>
        <line choice="app"/>
        <line choice="launcher"/>
    </choices-outline>
    <choice id="app" visible="false">
        <pkg-ref id="es.digio.pando"/>
    </choice>
    <choice id="launcher" visible="false">
        <pkg-ref id="es.digio.pando.launcher"/>
    </choice>
    <pkg-ref id="es.digio.pando"         version="${BUNDLE_VERSION}" onConclusion="none">pando-app.pkg</pkg-ref>
    <pkg-ref id="es.digio.pando.launcher" version="${BUNDLE_VERSION}" onConclusion="none">pando-launcher.pkg</pkg-ref>
</installer-gui-script>
XML

    local unsigned_pkg="$pkg_work/pando-${VERSION}-${arch_label}-unsigned.pkg"
    productbuild \
        --distribution "$dist_xml" \
        --package-path "$pkg_work" \
        "$unsigned_pkg"

    local final_pkg="$DIST_DIR/pando-${VERSION}-darwin-${arch_label}.pkg"
    rm -f "$final_pkg"

    if [[ -z "$PKG_SIGN_IDENTITY" ]]; then
        echo "PKG_SIGN_IDENTITY not set — leaving installer unsigned." >&2
        cp "$unsigned_pkg" "$final_pkg"
    else
        echo "Signing .pkg installer with productsign..."
        if productsign --keychain "$MACOS_SIGN_KEYCHAIN_PATH" --sign "$PKG_SIGN_IDENTITY" "$unsigned_pkg" "$final_pkg"; then
            :
        else
            echo "Warning: productsign failed for identity '$PKG_SIGN_IDENTITY' — leaving installer unsigned." >&2
            cp "$unsigned_pkg" "$final_pkg"
        fi
    fi

    if is_pkg_signed "$final_pkg"; then
        # Notarize & staple before the spctl assessment: an unnotarized Developer
        # ID package fails 'spctl --assess --type install', aborting under set -e.
        notarize_and_staple "$final_pkg"
        verify_pkg_signature "$final_pkg"
    else
        echo "Skipping .pkg notarization & verification because the installer is unsigned."
    fi

    echo "Compressing dist/$(basename "$final_pkg").zip..."
    ( cd "$DIST_DIR" && zip -q "$(basename "$final_pkg").zip" "$(basename "$final_pkg")" )

    echo "  → $final_pkg"
}

build_arch_package arm64 arm64 "$ARM64_ZIP"
build_arch_package x64   amd64 "$AMD64_ZIP"

# ── Done ─────────────────────────────────────────────────────────────────────

echo ""
echo "Done!"
echo "  arm64 .app : dist/Pando-arm64.app"
echo "  arm64 .pkg : dist/pando-${VERSION}-darwin-arm64.pkg"
echo "  x64   .app : dist/Pando-x64.app"
echo "  x64   .pkg : dist/pando-${VERSION}-darwin-x64.pkg"
